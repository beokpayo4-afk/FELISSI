# Copy this file to .env for local development.
# Never commit real secrets or production credentials.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-random-value

# DEBUG / ALLOWED_HOSTS — DJANGO_* names preferred; plain names also work on Render.
DJANGO_DEBUG=true
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false

# Local default is SQLite. For Neon/PostgreSQL, set a real DATABASE_URL in .env:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=true

# Comma-separated origins WITH scheme (https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Local filesystem uploads live under backend/uploads/ and are served at /uploads/.
# Leave UPLOAD_STORAGE_BACKEND empty in normal use. Tests set this to "memory".
UPLOAD_STORAGE_BACKEND=

# Payment gateway stub. Leave empty — do not add live credentials.
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

API_PUBLIC_ORIGIN=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5175
FRONTEND_APP_NAME=FELISSI
DEFAULT_FROM_EMAIL=filessipvtltd@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Render production examples (set these in the Render dashboard, not in Git) ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=<long-random-secret>
# DJANGO_DEBUG=false
# DEBUG=false
# DJANGO_ALLOWED_HOSTS=felissi-1.onrender.com
# ALLOWED_HOSTS=felissi-1.onrender.com
# DATABASE_URL=<postgres-url>
# API_PUBLIC_ORIGIN=https://felissi-1.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# Note: Render's disk is ephemeral unless you attach a persistent disk.
# Uploaded images under /uploads/ will be lost on redeploy without a disk.
