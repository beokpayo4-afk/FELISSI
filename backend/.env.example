# Copy this file to .env for local development.
# Never commit real secrets or production credentials.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-random-value

# DEBUG / ALLOWED_HOSTS — DJANGO_* names preferred; plain names also work on Render.
DJANGO_DEBUG=true
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false

# Local default is SQLite when empty. For Neon/PostgreSQL set a real URL in .env only.
DATABASE_URL=
DATABASE_SSL_REQUIRE=true

# Comma-separated origins WITH scheme (https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Local filesystem uploads under backend/uploads/, served at /uploads/.
# Empty = local filesystem. "memory" is for tests only. No R2/S3/MinIO.
UPLOAD_STORAGE_BACKEND=

# Payment gateway stub. Leave empty — do not add live credentials.
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

API_PUBLIC_ORIGIN=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5175
FRONTEND_APP_NAME=FELISSI
DEFAULT_FROM_EMAIL=filessipvtltd@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Render production (set in the Render dashboard; names only, no secrets) ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=   # >=50 chars and >=5 unique (Django W009). Prefer:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Render Generate alone is often ~44 chars and is NOT enough.
# DJANGO_DEBUG=false
# DEBUG=false
# DJANGO_ALLOWED_HOSTS=felissi-1.onrender.com
# ALLOWED_HOSTS=felissi-1.onrender.com
# DATABASE_URL=        # Neon postgresql://... URL (required)
# DATABASE_SSL_REQUIRE=true
# API_PUBLIC_ORIGIN=https://felissi-1.onrender.com
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# UPLOAD_STORAGE_BACKEND=
# PYTHON_VERSION=3.12.8
# Start command (Root Directory = backend):
# gunicorn config.asgi:application -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT
# Note: Render disk is ephemeral unless a persistent disk is attached.
