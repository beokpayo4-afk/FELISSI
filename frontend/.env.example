# Public frontend configuration (safe to commit as an example).
# Copy to .env.development for local work.
# Production builds use .env.production (or Vercel env) — not this file.
# Local Vite proxies /api to the Django backend (see vite.config.ts).

VITE_API_BASE_URL=/api
VITE_APP_NAME=FELISSI
VITE_APP_ENV=development
